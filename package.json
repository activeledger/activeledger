{
  "name": "activeledger-monorepo",
  "version": "5.1.8",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "npm run build:definitions && npm run build:logger && npm run build:utilities && npm run build:httpd && npm run build:options && npm run build:storage && npm run build:crypto && npm run build:activesync && npm run build:activep2p && npm run build:query && npm run build:contracts && npm run build:protocol && npm run build:network && npm run build:toolkits && npm run build:ledger && npm run build:restore && npm run build:hybrid",
    "build:utilities": "cd ./packages/utilities/ && npm run build",
    "build:options": "cd ./packages/options/ && npm run build",
    "build:logger": "cd ./packages/logger/ && npm run build",
    "build:hybrid": "cd ./packages/hybrid/ && npm run build",
    "build:httpd": "cd ./packages/httpd/ && npm run build",
    "build:definitions": "cd ./packages/definitions/ && npm run build",
    "build:activesync": "cd ./packages/activesync/ && npm run build",
    "build:crypto": "cd ./packages/crypto/ && npm run build",
    "build:activep2p": "cd ./packages/activep2p/ && npm run build",
    "build:query": "cd ./packages/query/ && npm run build",
    "build:contracts": "cd ./packages/contracts/ && npm run build",
    "build:toolkits": "cd ./packages/toolkits/ && npm run build",
    "build:storage": "cd ./packages/storage/ && npm run build",
    "build:protocol": "cd ./packages/protocol/ && npm run build",
    "build:network": "cd ./packages/network/ && npm run build",
    "build:ledger": "cd ./packages/activeledger/ && npm run build",
    "build:restore": "cd ./packages/restore/ && npm run build",
    "test": "mocha --node-option import=tsx tests/*.ts --exit -- --no-warnings",
    "test:network": "tsx tests/network/run.ts",
    "test:network:serve": "tsx tests/network/serve.ts",
    "test:network:pq": "tsx tests/network/pq-identity.ts",
    "test:network:contracts": "tsx tests/network/contract-entries.ts",
    "test:network:restore": "tsx tests/network/restore.ts",
    "test:network:lifecycle": "tsx tests/network/lifecycle.ts",
    "test:network:restore:load": "tsx tests/network/restore-load.ts",
    "test:network:restore:resume": "tsx tests/network/restore-resume.ts",
    "test:network:selfsign": "tsx tests/network/selfsign-impersonation.ts",
    "test:network:expiry": "tsx tests/network/authority-expiry.ts",
    "profile:tx": "tsx tests/network/profile.ts",
    "profile:stages": "tsx tests/network/profile-stages.ts",
    "stress:throughput": "tsx tests/stress/throughput.ts",
    "stress:cold-start": "tsx tests/stress/cold-start.ts",
    "stress:memory": "tsx tests/stress/memory.ts",
    "stress:realistic": "tsx tests/stress/realistic.ts",
    "stress:peak": "tsx tests/stress/realistic.ts --contract no-write --rates 300,500,700,900,1100,1300 --users 300 --label peak-reads --out stress-results/peak-reads.jsonl && tsx tests/stress/realistic.ts --contract returner --rates 300,500,600,700,800,900 --users 300 --label peak-writes --out stress-results/peak-writes.jsonl && tsx tests/stress/realistic.ts --from stress-results/peak-reads.jsonl,stress-results/peak-writes.jsonl --pdf stress-results/peak-load-test.pdf",
    "stress:compare": "tsx tests/stress/compare.ts",
    "version:set": "node scripts/set-version.mjs",
    "test:network:hybrid": "tsx tests/network/hybrid.ts",
    "test:behaviour": "tsx tests/network/behaviour-snapshot.ts",
    "test:behaviour:compare": "tsx tests/network/behaviour-compare.ts"
  },
  "devDependencies": {
    "@types/chai": "4.3.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "chai": "4.5.0",
    "mocha": "12.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
