{
  "name": "@activeledger/activehybrid",
  "description": "Activeledger Hybrid Connect, Maintain every permissioned chain yourself",
  "version": "4.5.16",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "blockchain",
    "dlt",
    "distributed ledger technology",
    "ledger",
    "smart contracts",
    "activeledger",
    "network",
    "hybrid"
  ],
  "homepage": "https://github.com/activeledger/activeledger",
  "preferGlobal": true,
  "bin": {
    "activehybrid": "./lib/index.js"
  },
  "scripts": {
    "start": "node lib/index.js",
    "build:commonjs": "tsc --outDir lib --module commonjs  && copyfiles -f ./src/default.config.json ./lib && copyfiles -u 3 ../activeledger/lib/contracts/default/* ./lib",
    "build:es": "tsc --outDir es --module es6  && copyfiles -f ./src/default.config.json ./es && copyfiles -u 3 ../activeledger/es/contracts/default/* ./es",
    "build": "npm run build:commonjs && npm run build:es",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeledger/activeledger.git"
  },
  "bugs": {
    "url": "https://github.com/activeledger/activeledger/issues"
  },
  "author": "Activeledger",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.10.1",
    "copyfiles": "2.4.1"
  },
  "files": [
    "es",
    "lib"
  ],
  "types": "./lib/index.d.ts",
  "jsnext:main": "./es/index.js",
  "module": "./es/index.js",
  "dependencies": {
    "@activeledger/activecontracts": "4.5.16",
    "@activeledger/activecrypto": "4.5.16",
    "@activeledger/activedefinitions": "4.5.16",
    "@activeledger/activelogger": "4.5.16",
    "@activeledger/activeoptions": "4.5.16",
    "@activeledger/activeprotocol": "4.5.16",
    "@activeledger/activestorage": "4.5.16",
    "@activeledger/activetoolkits": "4.5.16",
    "@activeledger/activeutilities": "4.5.16",
    "@activeledger/httpd": "4.5.16",
    "typescript": "5.6.3"
  },
  "gitHead": "0e3737c01cf21565ceee635a5b912af3020a5fd6"
}
