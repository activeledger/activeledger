{
  "name": "@activeledger/activehybrid",
  "description": "Activeledger Hybrid Connect, Maintain every permissioned chain yourself",
  "version": "5.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "blockchain",
    "dlt",
    "distributed ledger technology",
    "ledger",
    "smart contracts",
    "activeledger",
    "network",
    "hybrid"
  ],
  "homepage": "https://github.com/activeledger/activeledger",
  "preferGlobal": true,
  "bin": {
    "activehybrid": "./lib/index.js"
  },
  "scripts": {
    "start": "node lib/index.js",
    "build:commonjs": "tsc --outDir lib --module commonjs",
    "build:es": "tsc --outDir es --module es2022",
    "build": "npm run build:commonjs && npm run build:es",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeledger/activeledger.git"
  },
  "bugs": {
    "url": "https://github.com/activeledger/activeledger/issues"
  },
  "author": "Activeledger",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  },
  "files": [
    "es",
    "lib"
  ],
  "types": "./lib/index.d.ts",
  "jsnext:main": "./es/index.js",
  "module": "./es/index.js",
  "dependencies": {
    "@activeledger/activecontracts": "5.1.0",
    "@activeledger/activecrypto": "5.1.0",
    "@activeledger/activedefinitions": "5.1.0",
    "@activeledger/activeledger": "5.1.0",
    "@activeledger/activelogger": "5.1.0",
    "@activeledger/activeoptions": "5.1.0",
    "@activeledger/activep2p": "5.1.0",
    "@activeledger/activeprotocol": "5.1.0",
    "@activeledger/activestorage": "5.1.0",
    "@activeledger/activesync": "5.1.0",
    "@activeledger/activeutilities": "5.1.0",
    "typescript-api": "npm:typescript@6.0.3"
  },
  "gitHead": "0e3737c01cf21565ceee635a5b912af3020a5fd6"
}
