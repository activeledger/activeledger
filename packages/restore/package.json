{
  "name": "@activeledger/activerestore",
  "version": "5.1.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "This pakacage contains the application which handles the network healing and rebuilding from an empty Activeledger node.",
  "keywords": [
    "blockchain",
    "dlt",
    "distributed ledger technology",
    "ledger",
    "smart contracts",
    "activeledger",
    "network",
    "node"
  ],
  "homepage": "https://github.com/activeledger/activeledger",
  "preferGlobal": true,
  "bin": {
    "activerestore": "./lib/index.js"
  },
  "scripts": {
    "start": "node lib/index.js",
    "test": "cd ../../ && npm test",
    "build:commonjs": "tsc --outDir lib --module commonjs",
    "build:es": "tsc --outDir es --module es2022",
    "build": "npm run build:commonjs && npm run build:es",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeledger/activeledger.git"
  },
  "bugs": {
    "url": "https://github.com/activeledger/activeledger/issues"
  },
  "author": "Activeledger",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  },
  "files": [
    "es",
    "lib"
  ],
  "types": "./lib/index.d.ts",
  "jsnext:main": "./es/index.js",
  "module": "./es/index.js",
  "dependencies": {
    "@activeledger/activecontracts": "5.1.4",
    "@activeledger/activecrypto": "5.1.4",
    "@activeledger/activelogger": "5.1.4",
    "@activeledger/activenetwork": "5.1.4",
    "@activeledger/activeoptions": "5.1.4",
    "@activeledger/activesync": "5.1.4",
    "typescript-api": "npm:typescript@6.0.3"
  },
  "gitHead": "0e3737c01cf21565ceee635a5b912af3020a5fd6"
}
