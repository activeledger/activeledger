{
  "name": "@activeledger/activeledger",
  "version": "4.7.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "This package contains the main application for running the Activeledger blockchain",
  "keywords": [
    "blockchain",
    "dlt",
    "distributed ledger technology",
    "ledger",
    "smart contracts",
    "activeledger",
    "network",
    "node"
  ],
  "homepage": "https://github.com/activeledger/activeledger",
  "preferGlobal": true,
  "bin": {
    "activeledger": "./lib/index.js"
  },
  "scripts": {
    "start": "node lib/index.js",
    "test": "cd ../../ && npm test",
    "build:commonjs": "tsc --outDir lib --module commonjs && copyfiles -f ./src/default.config.json ./lib",
    "build:es": "tsc --outDir es --module es6 && copyfiles -f ./src/default.config.json ./es",
    "build": "npm run build:commonjs && npm run build:es && npm run postBuild",
    "postBuild": "node ./lib/post-build.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeledger/activeledger.git"
  },
  "bugs": {
    "url": "https://github.com/activeledger/activeledger/issues"
  },
  "author": "Activeledger",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.5.1",
    "copyfiles": "2.4.1",
    "typescript": "5.6.3"
  },
  "files": [
    "es",
    "lib"
  ],
  "types": "./lib/index.d.ts",
  "jsnext:main": "./es/index.js",
  "module": "./es/index.js",
  "dependencies": {
    "@activeledger/activecontracts": "4.7.1",
    "@activeledger/activecrypto": "4.7.1",
    "@activeledger/activelogger": "4.7.1",
    "@activeledger/activenetwork": "4.7.1",
    "@activeledger/activeoptions": "4.7.1",
    "@activeledger/activestorage": "4.7.1",
    "@activeledger/activetoolkits": "4.7.1"
  },
  "gitHead": "0e3737c01cf21565ceee635a5b912af3020a5fd6"
}
