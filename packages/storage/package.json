{
  "name": "@activeledger/activestorage",
  "version": "4.5.17",
  "description": "This package is Activeledger's built-in data storage engine",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "blockchain",
    "dlt",
    "distributed ledger technology",
    "ledger",
    "smart contracts",
    "activeledger",
    "network",
    "node"
  ],
  "homepage": "https://github.com/activeledger/activeledger",
  "main": "./lib/index.js",
  "files": [
    "es",
    "lib"
  ],
  "scripts": {
    "start": "node lib/index.js",
    "test": "cd ../../ && npm test",
    "build:commonjs": "tsc --outDir lib --module commonjs",
    "build:es": "tsc --outDir es --module es6",
    "build": "npm run build:commonjs && npm run build:es && copyfiles -u 1 ./src/fauxton/* ./lib/ && copyfiles -u 1 ./src/fauxton/**/*/* ./lib/ && copyfiles -u 1 ./src/pouchdb/*/lib/* ./lib/ && copyfiles -u 1 ./src/pouchdb/*/* ./lib/",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeledger/activeledger.git"
  },
  "bugs": {
    "url": "https://github.com/activeledger/activeledger/issues"
  },
  "author": "Activeledger",
  "license": "MIT",
  "devDependencies": {
    "@types/levelup": "^5.1.5",
    "@types/node": "24.10.1",
    "copyfiles": "2.4.1",
    "levelup": "5.1.1",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@activeledger/activelogger": "4.5.17",
    "@activeledger/activeoptions": "4.5.17",
    "@activeledger/activeutilities": "4.5.17",
    "@activeledger/httpd": "4.5.17",
    "classic-level": "^3.0.0"
  }
}
