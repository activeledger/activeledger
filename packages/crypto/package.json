{
  "name": "@activeledger/activecrypto",
  "version": "4.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "This package contains a wrapper for managing multiple cryptographic algorithms for Activeledger",
  "keywords": [
    "blockchain",
    "dlt",
    "distributed ledger technology",
    "ledger",
    "smart contracts",
    "activeledger",
    "network",
    "node"
  ],
  "homepage": "https://github.com/activeledger/activeledger",
  "main": "./lib/index.js",
  "scripts": {
    "start": "node lib/index.js",
    "test": "cd ../../ && npm test",
    "build:commonjs": "tsc --outDir lib --module commonjs",
    "build:es": "tsc --outDir es --module es2022",
    "build": "npm run build:commonjs && npm run build:es",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeledger/activeledger.git"
  },
  "bugs": {
    "url": "https://github.com/activeledger/activeledger/issues"
  },
  "author": "Activeledger",
  "license": "MIT",
  "devDependencies": {
    "@activeledger/activedefinitions": "4.10.1",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  },
  "files": [
    "es",
    "lib"
  ],
  "types": "./lib/index.d.ts",
  "jsnext:main": "./es/index.js",
  "module": "./es/index.js",
  "dependencies": {
    "@activeledger/activelogger": "4.10.1",
    "@noble/post-quantum": "^0.7.1",
    "asn1.js": "5.4.1"
  }
}
